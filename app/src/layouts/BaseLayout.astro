---
import { getCollection } from 'astro:content';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Study App', description = 'Obsidian Vault を正本にした学習ノート' } = Astro.props;
const pageTitle = title === 'Study App' ? title : `${title} | Study App`;
const currentPath = Astro.url.pathname;
const articles = (await getCollection('notes')).sort((a, b) => a.id.localeCompare(b.id, 'ja'));
const navigationItems: Array<
  | { kind: 'folder'; key: string; label: string; depth: number }
  | { kind: 'article'; key: string; label: string; depth: number; href: string }
> = [];
const seenFolders = new Set<string>();
const rootLabels: Record<string, string> = { study: '学習ノート', wiki: 'Wiki' };

for (const entry of articles) {
  const segments = entry.id.split('/');
  const folders = segments.slice(0, -1);
  folders.forEach((folder, index) => {
    const key = folders.slice(0, index + 1).join('/');
    if (seenFolders.has(key)) return;
    seenFolders.add(key);
    navigationItems.push({
      kind: 'folder',
      key,
      label: index === 0 ? (rootLabels[folder] ?? folder) : folder,
      depth: index
    });
  });
  navigationItems.push({
    kind: 'article',
    key: entry.data.id,
    label: entry.data.title ?? '未設定',
    depth: folders.length,
    href: `/articles/${entry.data.id}/`
  });
}
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f5" />
    <script is:inline>
      (() => {
        const themes = ['standard', 'wiki', 'living-aurora', 'blue-cosmos', 'pulse-neon'];
        try {
          const savedTheme = localStorage.getItem('study-app:theme');
          if (themes.includes(savedTheme)) document.documentElement.dataset.theme = savedTheme;
        } catch {
          // The standard theme remains usable when storage is unavailable.
        }
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Study App ホーム">
          <span class="brand-mark" aria-hidden="true">S</span>
          <span>Study App</span>
        </a>
        <div class="header-actions">
          <label class="theme-picker">
            <span class="theme-picker__label">テーマ</span>
            <span class="theme-picker__swatch" aria-hidden="true"></span>
            <select aria-label="表示テーマ" data-theme-picker>
              <option value="standard">Standard</option>
              <option value="wiki">Wiki</option>
              <option value="living-aurora">Living Aurora</option>
              <option value="blue-cosmos">Blue Cosmos</option>
              <option value="pulse-neon">Pulse Neon</option>
            </select>
          </label>
        </div>
      </div>
    </header>
    <div class="app-shell">
      <aside class="sidebar">
        <details class="sidebar-drawer" open>
          <summary>ページ</summary>
          <div class="sidebar-content">
            <nav class="primary-nav" aria-label="メインナビゲーション">
              <a class:list={{ active: currentPath === '/' }} href="/">すべての記事</a>
              <a class:list={{ active: currentPath === '/training/' }} href="/training/">研修資料</a>
            </nav>
            <nav class="page-tree" aria-label="記事の階層">
              <p class="sidebar-heading">ページツリー</p>
              <ul>
                {navigationItems.map((item) => (
                  <li class={`tree-${item.kind}`} style={`--tree-depth: ${item.depth}`}>
                    {item.kind === 'folder' ? (
                      <span><span aria-hidden="true">⌄</span>{item.label}</span>
                    ) : (
                      <a class:list={{ active: currentPath === item.href }} href={item.href}>{item.label}</a>
                    )}
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        </details>
      </aside>
      <div class="content-column">
        <main class="content-main">
          <slot />
        </main>
        <footer class="site-footer">
          <span>Study App</span>
          <a href="https://github.com/maruyamamasaya/studyApp" rel="noreferrer">GitHub</a>
        </footer>
      </div>
    </div>
    <script is:inline>
      (() => {
        const picker = document.querySelector('[data-theme-picker]');
        if (!(picker instanceof HTMLSelectElement)) return;

        const themeColors = {
          standard: '#f7f7f5',
          wiki: '#f8f5ec',
          'living-aurora': '#05070c',
          'blue-cosmos': '#020611',
          'pulse-neon': '#030607'
        };
        const applyTheme = (theme) => {
          if (!(theme in themeColors)) return;
          document.documentElement.dataset.theme = theme;
          picker.value = theme;
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', themeColors[theme]);
        };

        const initialTheme = document.documentElement.dataset.theme || 'standard';
        applyTheme(initialTheme);
        picker.addEventListener('change', () => {
          applyTheme(picker.value);
          try {
            localStorage.setItem('study-app:theme', picker.value);
          } catch {
            // Theme switching still works for this page when storage is unavailable.
          }
        });
      })();
    </script>
  </body>
</html>
