---
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const articles = (await getCollection('notes')).filter((entry) => entry.id.startsWith('training/')).sort((a, b) => b.data.created.localeCompare(a.data.created));
---

<BaseLayout title="研修資料" description="Study App の研修資料">
  <section class="page-intro compact">
    <p class="eyebrow">Training</p>
    <h1>研修資料</h1>
    <p>研修向けとして明示された記事だけを表示します。</p>
  </section>
  <section class="article-grid" aria-label="研修記事一覧">
    {articles.map((entry) => <ArticleCard article={entry.data} />)}
  </section>
</BaseLayout>
