---
import { getCollection } from 'astro:content';
import ArticleExplorer from '../components/ArticleExplorer.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = (await getCollection('notes')).sort((a, b) => b.data.created.localeCompare(a.data.created));
---

<BaseLayout>
  <ArticleExplorer articles={articles.map((entry) => entry.data)} />
</BaseLayout>
