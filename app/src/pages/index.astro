---
import { getCollection } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = (await getCollection('notes')).sort((a, b) => b.data.created.localeCompare(a.data.created));
---

<BaseLayout>
  <section class="page-intro">
    <p class="eyebrow">Markdown knowledge base</p>
    <h1>学習ノート</h1>
    <p>Phase 1 の代表記事を表示しています。記事は個別 URL から直接開けます。</p>
  </section>
  <section class="article-grid" aria-label="記事一覧">
    {articles.map((entry) => <ArticleCard article={entry.data} />)}
  </section>
</BaseLayout>
