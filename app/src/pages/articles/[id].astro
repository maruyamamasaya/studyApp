---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StudyProgressPanel from '../../components/StudyProgressPanel.astro';

export async function getStaticPaths() {
  const articles = await getCollection('notes');
  return articles.map((entry) => ({ params: { id: entry.data.id }, props: { entry } }));
}

interface Props { entry: CollectionEntry<'notes'> }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const title = entry.data.title ?? '未設定';
---

<BaseLayout title={title} description={`${title} — Study App の学習ノート`}>
  <div class="article-layout">
    <article>
      <header class:list={['article-header', { 'article-header--wiki': entry.data.type === 'wiki' }]}>
        <a class="back-link" href="/">記事一覧に戻る</a>
        <div class="card-meta"><span>{entry.data.type}</span><time>{entry.data.created}</time></div>
        <h1>{title}</h1>
        {entry.data.tags.length > 0 && <ul class="tags" aria-label="タグ">{entry.data.tags.map((tag) => <li>{tag}</li>)}</ul>}
        <StudyProgressPanel articleId={entry.data.id} articleType={entry.data.type} />
      </header>
      <div class="prose"><Content /></div>
    </article>
    {headings.length > 0 && (
      <details class="toc" open data-article-toc>
        <summary>目次</summary>
        <nav aria-label="目次">
          <ol>{headings.filter((heading) => heading.depth <= 3).map((heading) => <li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
        </nav>
      </details>
    )}
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const toc = document.querySelector('[data-article-toc]');
    if (!(toc instanceof HTMLDetailsElement)) return;
    const mobileArticle = window.matchMedia('(max-width: 860px)');
    const syncToc = () => { toc.open = !mobileArticle.matches; };
    syncToc();
    mobileArticle.addEventListener('change', syncToc);
    toc.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
      if (mobileArticle.matches) toc.open = false;
    }));
  })();
</script>
