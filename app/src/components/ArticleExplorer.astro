---
import searchIndex from '../../../generated/search-index.json';
import ArticleCard from './ArticleCard.astro';

interface Article {
  id: string;
  title: string | null;
  type: string;
  tags: string[];
  created: string;
}

interface Props {
  articles: Article[];
  label?: string;
}

const { articles, label = '記事一覧' } = Astro.props;
const searchById = new Map(searchIndex.map((entry) => [entry.id, entry]));
const availableTypes = new Set(articles.map((article) => article.type));
const showTypeFilters = availableTypes.size > 1;
---

<div class="article-explorer" data-article-explorer>
  <div class="article-explorer__controls">
    <label class="article-search">
      <span class="visually-hidden">記事を検索</span>
      <input type="search" placeholder="タイトル・タグ・本文を検索" autocomplete="off" data-article-search />
    </label>
    {showTypeFilters && (
      <div class="article-type-filter" role="group" aria-label="記事の種類">
        <button type="button" aria-pressed="true" data-article-type-filter="all">すべて</button>
        <button type="button" aria-pressed="false" data-article-type-filter="study">Study</button>
        <button type="button" aria-pressed="false" data-article-type-filter="wiki">Wiki</button>
      </div>
    )}
    <output class="article-explorer__count" aria-live="polite" data-article-count>{articles.length}件</output>
  </div>
  <section class="article-grid" aria-label={label}>
    {articles.map((article) => {
      const indexed = searchById.get(article.id);
      const searchText = [article.title, ...article.tags, ...(indexed?.aliases ?? []), indexed?.text].filter(Boolean).join(' ');
      return <ArticleCard article={article} searchText={searchText} />;
    })}
  </section>
  <p class="article-explorer__empty" hidden data-article-empty>該当する記事がありません。</p>
</div>

<script>
  import { matchesArticleFilter } from '../domain/article-search.mjs';

  document.querySelectorAll('[data-article-explorer]').forEach((root) => {
    if (!(root instanceof HTMLElement)) return;
    const input = root.querySelector('[data-article-search]');
    const count = root.querySelector('[data-article-count]');
    const empty = root.querySelector('[data-article-empty]');
    const items = [...root.querySelectorAll('[data-article-item]')];
    const filterButtons = [...root.querySelectorAll('[data-article-type-filter]')];
    let selectedType = 'all';

    const applyFilters = () => {
      const query = input instanceof HTMLInputElement ? input.value : '';
      let visibleCount = 0;
      items.forEach((item) => {
        if (!(item instanceof HTMLElement)) return;
        const visible = matchesArticleFilter({
          type: item.dataset.articleType ?? '',
          searchText: item.dataset.articleSearch ?? ''
        }, query, selectedType);
        item.hidden = !visible;
        if (visible) visibleCount += 1;
      });
      if (count instanceof HTMLOutputElement) count.value = `${visibleCount}件`;
      if (empty instanceof HTMLElement) empty.hidden = visibleCount !== 0;
    };

    input?.addEventListener('input', applyFilters);
    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        if (!(button instanceof HTMLButtonElement)) return;
        selectedType = button.dataset.articleTypeFilter ?? 'all';
        filterButtons.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
        applyFilters();
      });
    });
  });
</script>

