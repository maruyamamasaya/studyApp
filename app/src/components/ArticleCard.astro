---
interface Props {
  article: {
    id: string;
    title: string | null;
    type: string;
    tags: string[];
    created: string;
  };
  searchText?: string;
}

const { article, searchText = '' } = Astro.props;
---

<a
  class="article-card"
  href={`/articles/${article.id}/`}
  data-article-item
  data-article-type={article.type}
  data-article-search={searchText}
>
  <span class="article-card__type">{article.type}</span>
  <h2>{article.title ?? '未設定'}</h2>
  {article.tags.length > 0 && <span class="article-card__tags">{article.tags.join(' · ')}</span>}
  <time>{article.created.slice(0, 10)}</time>
</a>
