---
import PageTreeItems from './PageTreeItems.astro';

interface ArticleNode {
  kind: 'article';
  key: string;
  label: string;
  href: string;
  active: boolean;
}

interface FolderNode {
  kind: 'folder';
  key: string;
  label: string;
  depth: number;
  containsActive: boolean;
  children: Array<ArticleNode | FolderNode>;
}

interface Props {
  nodes: Array<ArticleNode | FolderNode>;
}

const { nodes } = Astro.props;
---

<ul class="tree-level">
  {nodes.map((node) => (
    <li class:list={['tree-node', `tree-${node.kind}`, { 'is-active-branch': node.kind === 'folder' && node.containsActive }]}>
      {node.kind === 'folder' ? (
        <details
          open={node.containsActive}
          data-tree-folder={node.key}
          data-active-branch={node.containsActive ? 'true' : undefined}
        >
          <summary><span class="tree-chevron" aria-hidden="true">›</span><span>{node.label}</span></summary>
          <PageTreeItems nodes={node.children} />
        </details>
      ) : (
        <a class:list={{ active: node.active }} aria-current={node.active ? 'page' : undefined} href={node.href}>{node.label}</a>
      )}
    </li>
  ))}
</ul>

